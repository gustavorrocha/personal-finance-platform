{
  "name": "finance-web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "npm@11.17.0",
  "scripts": {
    "build": "tsc --noEmit && node build.mjs",
    "lint": "node translate.mjs --check && tsc --noEmit && prettier --check src index.html build.mjs translate.mjs tsconfig.json package.json",
    "translate": "node translate.mjs",
    "test": "node --test src/*.test.ts"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "esbuild": "0.28.2",
    "prettier": "^3.6.0",
    "typescript": "^5.9.0"
  }
}
