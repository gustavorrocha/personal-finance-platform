<clickhouse>
  <profiles>
    <default>
      <log_queries>0</log_queries>
      <log_query_threads>0</log_query_threads>
      <max_execution_time>10</max_execution_time>
      <max_memory_usage>512000000</max_memory_usage>
    </default>
    <health>
      <readonly>1</readonly>
      <log_queries>0</log_queries>
      <max_execution_time>3</max_execution_time>
      <max_memory_usage>64000000</max_memory_usage>
      <max_result_rows>10</max_result_rows>
    </health>
  </profiles>
  <users>
    <default>
      <networks replace="replace"><ip>127.0.0.1</ip><ip>::1</ip></networks>
      <access_management>0</access_management>
    </default>
  </users>
</clickhouse>
